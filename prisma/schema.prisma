generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  brands    Brand[]
  brandGroups BrandGroup[]
}

model Brand {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  accessToken    String?
  threadsUserId  String?
  tokenExpiry    DateTime?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  formulaWeights String   @default("{}")
  brandConfig    String   @default("{}")
  growthMemory   String   @default("{}")
  viralMemory    String   @default("{}")
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id])
  posts          Post[]
  viralExamples  ViralExample[]
  viralPatterns  ViralPattern[]
  accountInsights AccountInsight[]
  conversionEvents ConversionEvent[]
  threadReplies    ThreadReply[]
  tikTokDrafts     TikTokVideoDraft[]
  instagramAccessToken  String?
  instagramUserId       String?
  instagramUsername     String?
  instagramTokenExpiry  DateTime?
  instagramConnectedAt  DateTime?
  groupId     String?
  group       BrandGroup? @relation(fields: [groupId], references: [id])
  marketLabel String?
  locale      String?
  channelAccounts ChannelAccount[]

  @@index([groupId])
}

model Post {
  id           String    @id @default(cuid())
  brandId      String
  brand        Brand     @relation(fields: [brandId], references: [id])
  content      String
  imageUrls    String    @default("[]")
  scheduledAt  DateTime
  status       String    @default("PENDING")
  threadsId    String?
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  errorLog     String?
  firstComment String?
  formulaId    String?
  topic        String?
  targetAudience String?
  situation    String?
  hookType     String?
  ctaType      String?
  qualityScore Int?
  qualityProfile String?
  qualityPass Boolean?
  qualityReasons String @default("[]")
  campaignId String?
  campaignFormulaId String?
  careerDecisionType String?
  linkUrl String?
  utmContent String?
  clicks Int?
  conversions Int?
  manualPaidConversions Int?
  views        Int?
  likes        Int?
  replies      Int?
  reposts      Int?
  metricsAt    DateTime?
  performanceScore Int?
  performanceTier  String?
  learnedAt    DateTime?
  conversionEvents ConversionEvent[]
  threadRootId       String?
  threadPartsPosted  Int       @default(0)
  threadTotalParts   Int       @default(1)
  threadPartIds      String    @default("[]")
  sideMission        String?
  postCategory       String    @default("GROWTH")
  algorithmicScore   Int?
  algorithmicPass    Boolean?
  algorithmicDimensions String @default("{}")
  algorithmicFixes   String    @default("[]")
  rewriteCount       Int       @default(0)
  instagramStatus       String?
  instagramContainerId  String?
  instagramMediaId      String?
  instagramPublishedAt  DateTime?
  instagramAttempts     Int       @default(0)
  instagramError        String?
  publications Publication[]

  @@index([brandId, instagramStatus])
  @@index([brandId, campaignId])
  @@index([brandId, scheduledAt])
  @@index([brandId, publishedAt])
  @@index([brandId, status])
  @@index([brandId, postCategory, status])
}

model ThreadReply {
  id              String   @id @default(cuid())
  brandId         String
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  postThreadsId   String
  replyThreadsId  String   @unique
  authorUsername  String
  authorText      String
  replyText       String?
  status          String   @default("DRAFT")
  isMention       Boolean  @default(false)
  isFollowUp      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([brandId, status])
  @@index([brandId, postThreadsId])
  @@index([brandId, createdAt])
}

model Settings {
  id             String   @id @default("default")
  accessToken    String
  userId         String
  tokenExpiry    DateTime
  updatedAt      DateTime @updatedAt
  formulaWeights String   @default("{}")
}

model ViralExample {
  id              String    @id @default(cuid())
  brandId         String
  brand           Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  source          String
  sourceKey       String
  authorUsername  String?
  permalink       String?
  content         String
  publishedAt     DateTime?
  discoveredAt    DateTime  @default(now())
  views           Int?
  likes           Int?
  replies         Int?
  reposts         Int?
  quotes          Int?
  shares          Int?
  engagementRate  Float?
  velocityScore   Int?
  viralScore      Int       @default(0)
  hookType        String?
  topic           String?
  targetAudience  String?
  emotionalDriver String?
  structureType   String?
  ctaType         String?
  patternSummary  String?
  keyTakeaway     String?
  rawMetrics      String    @default("{}")
  country         String?
  snapshots       ViralExampleSnapshot[]

  @@unique([brandId, source, sourceKey])
  @@index([brandId, viralScore])
  @@index([brandId, discoveredAt])
  @@index([brandId, source, publishedAt])
}

model ViralExampleSnapshot {
  id         String       @id @default(cuid())
  exampleId  String
  example    ViralExample @relation(fields: [exampleId], references: [id], onDelete: Cascade)
  capturedAt DateTime
  views      Int
  likes      Int?
  comments   Int?
  @@unique([exampleId, capturedAt])
  @@index([exampleId, capturedAt(sort: Desc)])
}

model ViralPattern {
  id              String   @id @default(cuid())
  brandId         String
  brand           Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  dimension       String
  value           String
  sourceCount     Int
  avgViralScore   Int
  confidence      Int
  exampleIds      String   @default("[]")
  recommendation  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([brandId, dimension, value])
  @@index([brandId, avgViralScore])
}

model AccountInsight {
  id          String   @id @default(cuid())
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  generatedAt DateTime @default(now())
  windowStart DateTime
  windowEnd   DateTime
  source      String   @default("cron")
  summary     String
  actions     String   @default("[]")
  metrics     String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([brandId, generatedAt])
}

model ConversionEvent {
  id             String   @id @default(cuid())
  brandId        String
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  postId         String?
  post           Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  eventType      String   // click, landing_view, test_start, signup, checkout_intent, paid_conversion
  amount         Float    @default(0)
  sessionId      String?
  idempotencyKey String?  @unique
  metadata       String   @default("{}")
  createdAt      DateTime @default(now())

  @@index([postId, eventType])
  @@index([brandId, createdAt])
}

model TikTokVideoDraft {
  id                String              @id @default(cuid())
  brandId           String
  campaignId        String
  formatId          String
  status            String              @default("DRAFT")
  title             String
  spokenHook        String
  script            String
  sceneBeats        String              @default("[]")
  captionOverlays   String              @default("[]")
  onScreenText      String              @default("[]")
  hashtags          String              @default("[]")
  cta               String
  landingUrl        String?
  utmContent        String?
  qualityProfile    String              @default("tiktok_career_timing")
  qualityPass       Boolean             @default(false)
  qualityScore      Int                 @default(0)
  qualityReasons    String              @default("[]")
  durationSeconds   Int                 @default(25)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  brand             Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  metrics           TikTokVideoMetric[]

  @@index([brandId, campaignId])
  @@index([brandId, createdAt])
  @@index([brandId, status])
}

model TikTokVideoMetric {
  id               String           @id @default(cuid())
  draftId          String
  measuredAt       DateTime         @default(now())
  views            Int              @default(0)
  likes            Int              @default(0)
  comments         Int              @default(0)
  shares           Int              @default(0)
  saves            Int              @default(0)
  profileClicks    Int              @default(0)
  landingClicks    Int              @default(0)
  conversions      Int              @default(0)
  performanceScore Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  draft            TikTokVideoDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, measuredAt])
}

model BrandGroup {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  markets   Brand[]
  createdAt DateTime @default(now())
}

model ChannelAccount {
  id             String    @id @default(cuid())
  brandId        String
  brand          Brand     @relation(fields: [brandId], references: [id])
  platform       String
  mode           String
  externalUserId String?
  handle         String?
  accessToken    String?
  refreshToken   String?
  tokenExpiry    DateTime?
  settings       String    @default("{}")
  enabled        Boolean   @default(true)
  connectedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publications   Publication[]

  @@unique([brandId, platform, externalUserId])
  @@index([brandId, enabled])
}

model Publication {
  id               String    @id @default(cuid())
  postId           String
  post             Post      @relation(fields: [postId], references: [id])
  channelAccountId String
  channelAccount   ChannelAccount @relation(fields: [channelAccountId], references: [id])
  status           String    @default("QUEUED")
  body             String?
  mediaUrls        String    @default("[]")
  scheduledAt      DateTime?
  publishedAt      DateTime?
  externalId       String?
  externalUrl      String?
  platformData     String    @default("{}")
  attempts         Int       @default(0)
  errorLog         String?
  views            Int?
  likes            Int?
  replies          Int?
  reposts          Int?
  clicks           Int?
  metricsAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([postId, channelAccountId])
  @@index([postId])
  @@index([channelAccountId, status, scheduledAt])
}
